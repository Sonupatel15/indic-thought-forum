{
  "name": "indic-thought-forum",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.22.3",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build && node scripts/finalize-export.mjs",
    "preview": "http-server out -p 4173 -a 127.0.0.1 -c-1",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "assets:prepare": "node scripts/prepare-assets.mjs",
    "assets:media": "node scripts/prepare-media.mjs",
    "assets:posters": "node scripts/prepare-event-posters.mjs",
    "assets:gallery": "node scripts/prepare-gallery-variants.mjs",
    "assets:branding": "node scripts/prepare-branding.mjs",
    "measure:performance": "node scripts/measure-performance.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "http-server": "14.1.1",
    "sharp": "0.35.5",
    "typescript": "^6.0.3"
  }
}
